{
  "expo": {
    "name": "NailPosVN",
    "slug": "nail-app",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "nail-app",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nicenailsspa.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Allow access to select staff profile photos.",
        "NSBluetoothAlwaysUsageDescription": "Bluetooth access is required to connect to the Stripe M2 card reader.",
        "NSBluetoothPeripheralUsageDescription": "Bluetooth access is required to connect to the Stripe M2 card reader.",
        "NSLocationWhenInUseUsageDescription": "Location access is required to connect to Bluetooth card readers."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.nicenailsspa.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d1b4502b-e670-4f3e-9f65-1ad85972235f",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#c9a96e",
          "defaultChannel": "default"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.nicenailsspa.app"
        }
      ],
      [
        "@stripe/stripe-terminal-react-native",
        {
          "bluetoothBackgroundMode": true,
          "locationWhenInUsePermission": "Location access is required to connect to card readers.",
          "bluetoothPeripheralPermission": "Bluetooth access is required to connect to card readers.",
          "bluetoothAlwaysUsagePermission": "Bluetooth access is required to connect to card readers.",
          "appDelegate": true,
          "tapToPayCheck": true
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d1b4502b-e670-4f3e-9f65-1ad85972235f"
      }
    },
    "newArchEnabled": false
  }
}
