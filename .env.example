# Cùng backend với website: NEXT_PUBLIC_API_URL (máy thật dùng IP LAN thay vì localhost)
EXPO_PUBLIC_API_URL=http://192.168.1.100:5001
# Tên tiệm trên Home / Settings lấy từ GET /api/public/salon (backend: SALON_DISPLAY_NAME, mặc định "Nice Nails & Spa"). Offline thì dùng Store Name đã lưu trên máy.

# --- OTA (EAS Update) ---
# Cần eas login. Đẩy bundle JS không qua App Store / Play:
#   npm run update:production -- --message "mô tả bản cập nhật"
# Bản cài trên máy phải build đúng channel (production/preview) và cùng runtimeVersion (app.json "version" với policy appVersion).

# Phóng to UI toàn app (tablet POS), 1 = tắt; khuyến nghị 1.1–1.2
# EXPO_PUBLIC_UI_SCALE=1.14

# Helcim Pay.js: mặc định HTML nhúng + baseUrl secure.helcim.app (tránh "refused to connect" khi trang cha là http://IP).
# Chỉ bật =1 khi backend có HTTPS + domain đã khai báo trong Helcim (Pay.js allowed origins).
# EXPO_PUBLIC_HELCIM_PAY_HOSTED_PAGE=1

# Thanh toán máy chạm thẻ (Helcim / Ingenico) trên màn New Ticket. Mặc định tắt; bật: 1 hoặc true
# EXPO_PUBLIC_ENABLE_CARD_PAYMENT=1

# Dev: POS tự seed vé; bấm Card chỉ POST /transactions (không máy thật) — không xuất hiện trong Helcim Dashboard
# EXPO_PUBLIC_POS_TEST_PAY=1
# Optional; if unset, AdminGate default PIN is 123456
EXPO_PUBLIC_ADMIN_PIN=123456

# --- Stripe Card Payment (thay thế / bổ sung cho Helcim) ---
# Bật thanh toán thẻ qua Stripe PaymentSheet: EXPO_PUBLIC_ENABLE_STRIPE=1
# EXPO_PUBLIC_ENABLE_STRIPE=1
# Publishable key từ Stripe Dashboard → Developers → API keys (pk_test_... hoặc pk_live_...)
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Location ID cho Stripe Terminal (Dashboard → Terminal → Locations) — bắt buộc để kết nối reader Bluetooth (M2/Chipper)
# EXPO_PUBLIC_STRIPE_LOCATION_ID=tml_...
# Bật reader giả lập (sandbox) để test luồng thanh toán thẻ KHÔNG CẦN máy đọc thẻ thật,
# không tốn phí Stripe, không charge tiền thật. Chỉ dùng ở Test Mode — TẮT (=0 hoặc xoá dòng) khi build live.
# EXPO_PUBLIC_STRIPE_SIMULATED_READER=1

# Múi giờ salon (IANA). Receipts POS + ngày giao dịch dùng giá trị này — backend cần SALON_TIMEZONE cùng giá trị để số appointment/turn khớp.
# Ví dụ: America/Phoenix, America/Chicago, America/New_York, America/Los_Angeles
EXPO_PUBLIC_SALON_TIMEZONE=America/Phoenix
# Tùy chọn: nhãn ngắn trên UI (nếu bỏ trống sẽ tự lấy từ timezone, vd "Phoenix")
# EXPO_PUBLIC_SALON_TZ_LABEL=Phoenix
